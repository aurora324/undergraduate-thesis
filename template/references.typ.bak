#import "../utils/font.typ": *

#let references(
  bibPath: "../references.bib",
  show_both: false
) = {
  pagebreak(weak: true)
  context {
    align(center)[
      #hide[
        #heading(
          level: 1,
          numbering: none,
          "References"
        )
        #v(-20pt)
      ]
      #text(
        font: FONTS.黑体,
        size: FSIZE.三号,
        weight: "bold",
        "References"
      )
    ]
    align(left)[
      #v(3em)
      #set text(
        font: FONTS.宋体,
        size: FSIZE.五号,
        lang: "en"
      )
      #bibliography(
        bibPath,
        title: none,
        style: "ieee"
      )
    ]
  }
}  
